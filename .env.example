# Postgres container (docker-compose.yml) and backend connection
POSTGRES_USER=everest
POSTGRES_PASSWORD=
POSTGRES_DB=everest
POSTGRES_TEST_DB=everest_test
DB_HOST=localhost
DB_PORT=5435

# Auth
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# Buyer emails (order confirmed + tracking link). Leave SMTP_HOST blank to turn mail off.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the gmail address>,
# SMTP_PASSWORD=<a 16-letter app password, Google account > Security > App passwords>,
# MAIL_FROM=<same gmail address>. WEB_URL is where buyers open links, e.g. http://192.168.1.20:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
WEB_URL=
